# =============================================================
# Memservice monorepo - single .env for web, admin and api
# (loaded by each app's next.config via @next/env). NEVER commit.
# =============================================================

# ---- App URLs / ports (web:3000  api:3001  admin:3002) ----
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL_FRONTEND=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# API base URL: server-side (web) and browser-side (web/admin)
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL_DEV=http://localhost:3001
NEXT_PUBLIC_APP_URL_PRODUCTION=http://localhost:3001

# ---- Database ----
# Local Docker MongoDB (single-node replica set; the order API uses transactions)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/memservice?replicaSet=rs0&directConnection=true
MONGO_URI=mongodb://localhost:27017/memservice?replicaSet=rs0&directConnection=true
ENVIRONMENT=development
# Remote Atlas DB - only used by "pnpm db:pull-atlas" (read-only copy to local)
ATLAS_MONGODB_URI=

# ---- Security ----
# Browser origins allowed to call the API with credentials (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
# Production only: parent domain so the admin session cookie is also sent to the API, e.g. .memservicebd.com
COOKIE_DOMAIN=

# ---- Auth ----
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Resend) ----
# Create an API key and verify your sending domain in the Resend dashboard (https://resend.com).
# Without RESEND_API_KEY emails are skipped (logged) and nothing else breaks.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Mem Service <orders@yourdomain.com>".
# (onboarding@resend.dev only delivers to your own Resend account email.)
EMAIL_FROM="Mem Service <onboarding@resend.dev>"
EMAIL_REPLY_TO=memservicebd@gmail.com
# Inbox that receives internal notifications (e.g. newsletter signups)
EMAIL_ADMIN_TO=

# ---- bKash (sandbox) ----
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
PAYERREFERENCE=
